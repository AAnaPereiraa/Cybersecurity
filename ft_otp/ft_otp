#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
from cryptography.fernet import Fernet
import hashlib
import hmac
import string
import time

ENCRYPTION_KEY_PATH = Path.home() / ".config" / "ft_otp" / "encryption.key"

def Parsingargs():
    parser = argparse.ArgumentParser()

    modes = parser.add_mutually_exclusive_group(required=True)

    modes.add_argument(
        "-g",
        dest="key_file",
        help="hexadecimal key file"
    )

    modes.add_argument(
        "-k",
        dest="gen_pass",
        help=".key file"
    )

    args = parser.parse_args()

    return args


def is_valid_hex(key):
    if len(key) >= 64:
        for char in key:
            if char in string.hexdigits:
                continue
            else:
                print("Not hexadecimal key")
                return False
    else:
        print("key must contain at least 64 hexadecimal characters")
        return False
    return True


def key_process(filename):

    if not os.path.isfile(filename):
        print("File does not exist")
        raise ValueError()
    
    try:
        with open(filename, "r", encoding="utf-8") as file:
            content = file.read().strip()
    
    except (PermissionError):
        print(f"Permission denied: {filename}")
        raise ValueError()

    if not is_valid_hex(content):
        raise ValueError()

    Savekey(filename)

    return 


def Savekey(hexkey):

    with open(hexkey, "r", encoding="utf-8") as file:
            key = file.read().strip()

    encryption_key = Fernet.generate_key()
    cipher = Fernet(encryption_key)
    key = bytes.fromhex(key)
    encrypted_key = cipher.encrypt(key)

    with open("ft_otp.key", "wb") as file:
        file.write(encrypted_key)

    ENCRYPTION_KEY_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(ENCRYPTION_KEY_PATH, "wb") as file:
        file.write(encryption_key)
    ENCRYPTION_KEY_PATH.chmod(0o600)

    print("Key successfully saved")

    return


def gen_pass(filename):

    if not os.path.isfile(filename):
        print("File does not exist")
        raise ValueError()

    key = decrypt_key(filename)
    counter = int(time.time()) // 30
    counter_bytes = counter.to_bytes(8, byteorder="big")
    digest = hmac.new(
        key,
        counter_bytes,
        hashlib.sha1
    ).digest()
    offset = digest[-1] & 0x0F
    number = int.from_bytes(
        digest[offset:offset + 4],
        byteorder="big"
    ) & 0x7FFFFFFF
    print(f"{number % 1_000_000:06d}")
    
    return 


def decrypt_key(filename):
    with open(ENCRYPTION_KEY_PATH, "rb") as file:
        encryption_key = file.read()

    with open(filename, "rb") as file:
        encrypted_key = file.read()

    cipher = Fernet(encryption_key)
    hex_key = cipher.decrypt(encrypted_key)
    
    return hex_key


def main():
    args = Parsingargs()
    try:
        if (args.key_file):
            key_process(args.key_file)
        elif (args.gen_pass):
            gen_pass(args.gen_pass)
    
    except(ValueError):
        return

    return


if __name__ == "__main__":
    main()